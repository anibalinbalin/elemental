# Mercado Pago — Checkout Pro (server-only)
# Get from: Mercado Pago → Tus integraciones → Credenciales
MP_ACCESS_TOKEN=

# Public base URL of the deployed site. Used to build Checkout Pro return URLs
# (back_urls) and the webhook notification_url. Leave unset in local dev — the
# request origin is used and auto_return/webhooks are skipped on localhost.
# APP_URL=https://elementalbloomco.com
