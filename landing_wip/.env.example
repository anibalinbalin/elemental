# ── Mercado Pago (Uruguay) ────────────────────────────────────
# Panel: https://www.mercadopago.com.uy/developers/panel/app
#   → Tus integraciones → (tu app) → Credenciales
# Sandbox/pruebas: TEST-...   |   Producción: APP_USR-...
MP_ACCESS_TOKEN=

# Firma secreta del webhook (se genera al crear el webhook en el panel de MP).
# Si queda vacía, el webhook NO valida la firma (solo aceptable en pruebas locales).
MP_WEBHOOK_SECRET=

# URL pública del sitio. Opcional: si no se define, se usa el origin del request.
# En producción definila con tu dominio, ej: https://elementalbloom.com
# APP_URL=

# ── Google Analytics 4 ────────────────────────────────────────
# ID de medición de la propiedad GA4: Admin → Flujos de datos → (web) → ID de medición.
# Formato: G-XXXXXXXXXX. Si queda vacío, gtag.js NO se carga (sin tracking).
# Es público (se expone al cliente), por eso el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_GA_ID=
